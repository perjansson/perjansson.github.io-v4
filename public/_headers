/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' https://images.ctfassets.net https://avatars.githubusercontent.com https://*.google-analytics.com data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://www.googletagmanager.com; font-src 'self'

# Next writes the generated social card as an extensionless file, so the CDN
# has nothing to guess a type from. Combined with the nosniff above, an
# octet-stream would make every scraper drop the preview.
/projects/:id/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600
